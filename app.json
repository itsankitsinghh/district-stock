{
  "expo": {
    "name": "District Stock",
    "slug": "district-stock",
    "version": "1.0.33",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.districtstock.app",
      "adaptiveIcon": {
        "backgroundColor": "#5213C2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow District Stock to access your camera to scan barcodes and document item condition."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow District Stock to access your photos.",
          "cameraPermission": "Allow District Stock to use your camera to take damage photos."
        }
      ],
      "expo-sharing"
    ]
  }
}
